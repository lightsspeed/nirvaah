POSTGRES_DB=finance
POSTGRES_USER=finance
# Generate a strong password: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-too

# ── Backups ────────────────────────────────────────────────────────────────
# How often the agent checks for changes (hours). 4 is a good default.
BACKUP_INTERVAL_HOURS=4
# Keep daily archives this long, plus the 1st of every month for a year.
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_MONTHS=12
# Offsite target. Leave S3_BUCKET empty to keep backups local-only.
# Works with S3, Cloudflare R2 (no egress fees), Backblaze B2 or MinIO.
S3_BUCKET=
S3_PREFIX=nirvaah/postgres
S3_ENDPOINT=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TZ=Asia/Kolkata

# ── Assistant (local Ollama) ───────────────────────────────────────────────
# Ollama runs on the host; the backend container reaches it through the docker
# gateway mapped in docker-compose.yml. Pull the model once: ollama pull qwen2.5:3b
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=8192

# ── Assistant cloud fallback (optional) ────────────────────────────────────
# Any OpenAI-compatible endpoint. The model picker on the Assistant page lets you
# pin one of the models this endpoint lists. Leave the key empty to stay
# local-only. DEEPSEEK_API_KEY / DEEPSEEK_API_URL are honoured as well:
FALLBACK_BASE_URL=https://api.deepseek.com/v1
FALLBACK_MODEL=deepseek-flash
FALLBACK_API_KEY=
ASSISTANT_FALLBACK=on

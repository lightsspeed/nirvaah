# TLS and a single public entry point. Certificates come from Let's Encrypt
# over HTTP-01 as soon as the Route 53 A record points here; renewal is
# automatic and lives in the caddy_data volume.
{
	email {$ACME_EMAIL}
	admin off
}

{$APP_HOST} {
	encode zstd gzip

	header {
		# HSTS without includeSubDomains: other services on this zone keep their own policy.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# nginx inside the frontend container already serves the SPA and proxies
	# /api/ to the backend on the private compose network.
	reverse_proxy frontend:8080
}
